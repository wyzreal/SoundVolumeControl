<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>org.soundvolumecontrol.broker</string>
    <key>ProgramArguments</key><array><string>/Library/PrivilegedHelperTools/org.soundvolumecontrol.broker</string></array>
    <key>MachServices</key><dict>
        <key>org.soundvolumecontrol.broker.writer</key><true/>
        <key>org.soundvolumecontrol.broker.reader</key><true/>
    </dict>
    <key>ProcessType</key><string>Background</string>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>Umask</key><integer>63</integer>
</dict></plist>
